<?xml version="1.0" encoding="utf-8"?>
<!-- Chỉ bản sideload (APK tự cài) xin "Truy cập mọi tệp": nhận được đường dẫn tuyệt đối từ MacroDroid (D4, D6).
     Play không cho quyền này nếu không có lý do đặc biệt, nên bản play không khai báo. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- Android 8–10 chưa có "Truy cập mọi tệp": đọc đường dẫn bằng quyền đọc bộ nhớ (Stage 6). -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <!-- Nút xin miễn tối ưu pin ở trang Tự động hoá (D69, Stage 6). Bản play không có: chính sách Play hạn chế quyền này. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

</manifest>
