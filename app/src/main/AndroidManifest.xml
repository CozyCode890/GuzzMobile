<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Gọi Google AI Studio (Stage 3). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Hàng đợi chạy nền (Stage 4): foreground service, Android 15+ loại mediaProcessing, Android 8–14 dataSync. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- FGS không giữ CPU thức khi màn hình tắt (Stage 1): service giữ partial wake lock trong lúc chạy. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!--
        D55: không sao lưu dữ liệu app (API key đã mã hoá, tệp hạn mức, cài đặt) lên Drive, không chép sang máy mới.
        Từ Android 12, allowBackup="false" chỉ tắt sao lưu đám mây; chuyển máy (device-to-device) phải chặn bằng
        dataExtractionRules. Khoá Keystore không đi theo nên key chép sang máy mới cũng không giải mã được.
    -->
    <application
        android:name=".GuzzApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Guzz">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".TranscriptActivity"
            android:exported="false"
            android:label="@string/transcript_title" />

        <!-- Mở / chia sẻ bản chép lời ghi bằng đường dẫn (thư mục ra của bản debug), và lối lùi khi app nhận không đọc
             được URI SAF (Rủi ro của Stage 4). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".SpeakersActivity"
            android:exported="false"
            android:label="@string/speakers_title"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".AudioActivity"
            android:exported="false"
            android:label="@string/audio_title" />

        <activity
            android:name=".AutomationActivity"
            android:exported="false"
            android:label="@string/automation_title"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".GoogleAiActivity"
            android:exported="false"
            android:label="@string/google_ai_title"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>
