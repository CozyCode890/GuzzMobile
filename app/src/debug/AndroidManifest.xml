<?xml version="1.0" encoding="utf-8"?>
<!-- Chỉ bản debug (D49): màn hình thử lõi âm thanh của Stage 2 và service chạy nó lúc tắt màn hình. Quyền FGS, thông
     báo, wake lock đã chuyển sang manifest chính ở Stage 4 (service hàng đợi thật). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- exported để chạy được bằng adb shell am start (lệnh đầy đủ ở KDoc của AudioDebugActivity). -->
        <activity
            android:name=".debug.AudioDebugActivity"
            android:exported="true"
            android:label="@string/debug_audio_title" />

        <!-- Dừng bằng adb lúc màn hình tắt (xem KDoc). -->
        <receiver
            android:name=".debug.AudioDebugStopReceiver"
            android:exported="true" />

        <!-- Lệnh adb cho hàng đợi thật (Stage 4, D2), xem KDoc và tools/device/queue_debug.ps1. -->
        <receiver
            android:name=".debug.QueueDebugReceiver"
            android:exported="true" />

        <service
            android:name=".debug.AudioDebugService"
            android:exported="false"
            android:foregroundServiceType="mediaProcessing|dataSync" />
    </application>

</manifest>
